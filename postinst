#!/bin/bash

# postinst - Post-installation script for Boost iPhone 6s-X v7.0
# Target: Rootless Jailbreak (iOS 14.0 - 26.0.1)

set +e # Tiếp tục thực thi dù có lỗi nhỏ

echo ""
echo "=================================================="
echo "   BOOST iPHONE 6s-X ULTIMATE EDITION v7.0"
echo "   Status: INSTALLING..."
echo "=================================================="

# 1. ĐẶT QUYỀN HẠN CHO BUNDLE SETTINGS
# ★ QUAN TRỌNG: Đảm bảo SpringBoard đọc được bundle mà không bị permission denied
BUNDLE_PATH="/var/jb/Library/PreferenceBundles/BoostiPhone6sPrefs.bundle"
if [ -d "$BUNDLE_PATH" ]; then
    chmod -R 755 "$BUNDLE_PATH"
    chown -R mobile:mobile "$BUNDLE_PATH"
    echo "[OK] Settings Bundle permissions fixed."
else
    echo "[WARN] Settings Bundle not found at $BUNDLE_PATH"
fi

# 2. RESET TRẠNG THÁI SAFE MODE
# ★ FIX: Xóa key Safe Mode cũ để đảm bảo tweak khởi động bình thường lần đầu
if command -v defaults &> /dev/null; then
    defaults delete com.boostiphone6s.settings BoostiPhone6s_SafeModeActive 2>/dev/null || true
    defaults delete com.boostiphone6s.settings BoostiPhone6s_LastCrashReason 2>/dev/null || true
    echo "[OK] Safe Mode state reset for fresh install."
fi

# 3. KHỞI TẠO THƯ MỤC CACHE RIÊNG (NẾU CHƯA CÓ)
TWEAK_CACHE="/var/mobile/Library/Caches/com.boostiphone6s.settings"
if [ ! -d "$TWEAK_CACHE" ]; then
    mkdir -p "$TWEAK_CACHE"
    chown mobile:mobile "$TWEAK_CACHE"
    chmod 755 "$TWEAK_CACHE"
    echo "[OK] Tweak cache directory created."
fi

# 4. REFRESH PREFERENCE LOADER CACHE
# Gửi signal HUP để cfprefsd reload danh sách entry mới nhất
# An toàn hơn killall -9 trên Rootless
if pidof cfprefsd > /dev/null 2>&1; then
    killall -HUP cfprefsd >/dev/null 2>&1 || true
    echo "[OK] Preference cache refreshed."
else
    echo "[INFO] cfprefsd not running. Will refresh after respring."
fi

echo ""
echo "=================================================="
echo "   INSTALLATION COMPLETE!"
echo "   Please RESPRING your device to apply changes."
echo "=================================================="
echo ""

exit 0
