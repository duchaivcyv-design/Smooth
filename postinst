set -e

if [ -d "/var/jb/Library/PreferenceBundles/BoostiPhone6sPrefs.bundle" ]; then
    chmod -R 755 /var/jb/Library/PreferenceBundles/BoostiPhone6sPrefs.bundle 2>/dev/null || true
    chown -R mobile:mobile /var/jb/Library/PreferenceBundles/BoostiPhone6sPrefs.bundle 2>/dev/null || true
fi

if [ -f "/var/jb/Library/PreferenceLoader/BoostiPhone6sPrefs.plist" ]; then
    chmod 644 /var/jb/Library/PreferenceLoader/BoostiPhone6sPrefs.plist 2>/dev/null || true
    chown mobile:mobile /var/jb/Library/PreferenceLoader/BoostiPhone6sPrefs.plist 2>/dev/null || true
fi

defaults delete com.taojb.boostiphone6s BoostV20_SafeModeActive 2>/dev/null || true
defaults delete com.taojb.boostiphone6s BoostiPhone6s_SafeModeActive 2>/dev/null || true

killall cfprefsd 2>/dev/null || true

if command -v uicache &> /dev/null; then
    uicache -p /var/jb/Library/PreferenceBundles/BoostiPhone6sPrefs.bundle 2>/dev/null || true
fi

exit 0
