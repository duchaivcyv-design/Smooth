<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!-- ============================================================ -->
    <!-- PLATFORM BINARY & AMFI TRUST ENGINE                          -->
    <!-- ============================================================ -->
    <key>platform-application</key>
    <true/>

    <key>com.apple.private.skip-library-validation</key>
    <true/>

    <key>com.apple.private.amfi.can-load-cdhash</key>
    <true/>

    <!-- ============================================================ -->
    <!-- DEEP SANDBOX BREAKOUT & VFS ROOT ACCESS                      -->
    <!-- ============================================================ -->
    <key>com.apple.private.security.no-sandbox</key>
    <true/>

    <key>com.apple.private.security.no-container</key>
    <true/>

    <key>com.apple.private.security.container-required</key>
    <false/>

    <key>com.apple.security.exception.files.absolute-path.read-write</key>
    <array>
        <string>/</string>
        <string>/private/</string>
        <string>/var/</string>
        <string>/tmp/</string>
        <string>/System/</string>
        <string>/Library/</string>
        <string>/dev/</string>
    </array>

    <key>com.apple.security.exception.files.home-relative-path.read-write</key>
    <array>
        <string>~/</string>
    </array>

    <key>com.apple.private.vfs.authorized-access</key>
    <true/>

    <key>com.apple.private.vfs.snapshot-access</key>
    <true/>

    <!-- ============================================================ -->
    <!-- STORAGE ACCESS — TOÀN BỘ PHÂN VÙNG HỆ THỐNG                   -->
    <!-- ============================================================ -->
    <key>com.apple.private.security.storage.AppBundles</key>
    <true/>

    <key>com.apple.private.security.storage.AppDataContainers</key>
    <true/>

    <key>com.apple.private.security.storage.MobileDocuments</key>
    <true/>

    <key>com.apple.private.security.storage.Preferences</key>
    <true/>

    <key>com.apple.private.security.storage.SystemPreferences</key>
    <true/>

    <key>com.apple.private.security.storage.Log</key>
    <true/>

    <key>com.apple.private.security.storage.Media</key>
    <true/>

    <key>com.apple.private.security.storage.Caches</key>
    <true/>

    <key>com.apple.private.security.storage.Tmp</key>
    <true/>

    <!-- ============================================================ -->
    <!-- TCC OVERRIDE — QUYỀN TRUY CẬP DỮ LIỆU BẢO MẬT                -->
    <!-- ============================================================ -->
    <key>com.apple.private.tcc.allow</key>
    <array>
        <string>kTCCServiceSystemPolicyAllFiles</string>
        <string>kTCCServiceSystemPolicySysAdminFiles</string>
        <string>kTCCServiceAddressBook</string>
        <string>kTCCServiceCalendar</string>
        <string>kTCCServicePhotos</string>
        <string>kTCCServiceCamera</string>
        <string>kTCCServiceMicrophone</string>
        <string>kTCCServiceLocation</string>
        <string>kTCCServiceUserTracking</string>
        <string>kTCCServiceReminders</string>
        <string>kTCCServiceMediaLibrary</string>
    </array>

    <!-- ============================================================ -->
    <!-- TASK PORTS, VM & KERNEL MEMORY WRITE ACCESS                  -->
    <!-- ============================================================ -->
    <key>get-task-allow</key>
    <true/>

    <key>task_for_pid-allow</key>
    <true/>

    <key>com.apple.system-task-ports</key>
    <true/>

    <key>com.apple.system-task-ports.control</key>
    <true/>

    <key>com.apple.system-task-ports.read</key>
    <true/>

    <key>com.apple.private.kernel.get-kauth</key>
    <true/>

    <key>com.apple.private.allow-read-sysctl</key>
    <true/>

    <key>com.apple.private.allow-write-sysctl</key>
    <true/>

    <!-- ============================================================ -->
    <!-- MACH PORTS & EXCEPTION LOOKUPS                               -->
    <!-- ============================================================ -->
    <key>com.apple.security.exception.mach-lookup.global-name</key>
    <array>
        <string>com.apple.system.logger</string>
        <string>com.apple.system.notification_center</string>
        <string>com.apple.springboard.services</string>
        <string>com.apple.backboardd</string>
        <string>com.apple.backboardd.services</string>
        <string>com.apple.ios.clock</string>
        <string>com.apple.runningboard</string>
        <string>com.apple.CARenderServer</string>
        <string>com.apple.windowserver.active</string>
        <string>com.apple.iohideventsystem</string>
        <string>com.apple.assertiond.processassertionconnection</string>
        <string>com.apple.frontboard.workspace</string>
        <string>com.apple.powerlog.plxpclogger.xpc</string>
    </array>

    <!-- ============================================================ -->
    <!-- IOKIT & HARDWARE ACCELERATION DRIVERS                        -->
    <!-- ============================================================ -->
    <key>com.apple.security.iokit-user-client-class</key>
    <array>
        <string>IOPMrootDomain</string>
        <string>AppleARMIODevice</string>
        <string>AppleSmartBattery</string>
        <string>AppleSmartBatteryCommands</string>
        <string>IOPlatformPluginDevice</string>
        <string>AppleARMPMU</string>
        <string>AppleARMPE</string>
        <string>AppleSMC</string>
        <string>IOHIDSystem</string>
        <string>IOHIDEventSystem</string>
        <string>IOHIDEventService</string>
        <string>IOHIDResourceDeviceUserClient</string>
        <string>AppleSPUHIDDevice</string>
        <string>AppleSPUHIDDriver</string>
        <string>AGXDeviceUserClient</string>
        <string>AGXSharedUserClient</string>
        <string>IOSurfaceRootUserClient</string>
    </array>

    <!-- ============================================================ -->
    <!-- HID, TOUCH DIRECT DELIVERY & BACKBOARDD                      -->
    <!-- ============================================================ -->
    <key>com.apple.private.hid.client.event-dispatch</key>
    <true/>

    <key>com.apple.private.hid.client.event-filter</key>
    <true/>

    <key>com.apple.private.hid.client.event-monitor</key>
    <true/>

    <key>com.apple.private.backboardd.allow-restricted-services</key>
    <true/>

    <!-- ============================================================ -->
    <!-- CODE SIGNING & MEMORY EXECUTION (FORCE-WRITE/JIT)            -->
    <!-- ============================================================ -->
    <key>dynamic-codesigning</key>
    <true/>

    <key>com.apple.private.cs.debugger</key>
    <true/>

    <key>com.apple.private.cs.allow-jit</key>
    <true/>

    <key>com.apple.private.cs.allow-unsigned-executable-memory</key>
    <true/>

    <key>com.apple.private.cs.restrict</key>
    <false/>

    <!-- ============================================================ -->
    <!-- JETSAM & MEMORY STATUS KERNEL CONTROLLER                     -->
    <!-- ============================================================ -->
    <key>com.apple.private.memorystatus</key>
    <true/>

    <!-- ============================================================ -->
    <!-- MOBILEGESTALT CACHE & HARDWARE KEYS                          -->
    <!-- ============================================================ -->
    <key>com.apple.private.mobilegestalt</key>
    <true/>

    <key>com.apple.private.MobileGestalt.AllowedProtectedKeys</key>
    <array>
        <string>SupportsVariableRefreshRate</string>
        <string>supports-variable-refresh-rate</string>
        <string>pVRR</string>
        <string>pro-motion</string>
        <string>DeviceSupports120Hz</string>
        <string>DeviceSupportsProMotion</string>
        <string>ProductType</string>
        <string>UniqueDeviceID</string>
        <string>BoardId</string>
        <string>HWModel</string>
        <string>ArtworkDeviceSubType</string>
        <string>DeviceClass</string>
        <string>SiriMode</string>
    </array>

    <!-- ============================================================ -->
    <!-- NETWORK PROTOCOLS                                            -->
    <!-- ============================================================ -->
    <key>com.apple.security.network.client</key>
    <true/>

    <key>com.apple.security.network.server</key>
    <true/>

    <!-- ============================================================ -->
    <!-- RUNNINGBOARD, PROCESS ASSERTIONS & LAUNCH SERVICES           -->
    <!-- ============================================================ -->
    <key>com.apple.runningboard.assertions.frontboard</key>
    <true/>

    <key>com.apple.runningboard.assertions.background</key>
    <true/>

    <key>com.apple.runningboard.terminateprocess</key>
    <true/>

    <!-- ============================================================ -->
    <!-- SPRINGBOARD RUNTIME DOMINANCE                                -->
    <!-- ============================================================ -->
    <key>com.apple.springboard.launchapplications</key>
    <true/>

    <key>com.apple.springboard.homescreenunhidden</key>
    <true/>

    <key>com.apple.springboard.debugapplications</key>
    <true/>

    <key>com.apple.springboard.watchdog-ok</key>
    <true/>

    <!-- ============================================================ -->
    <!-- GRAPHICS, METAL PIPELINE & CARenderServer                    -->
    <!-- ============================================================ -->
    <key>com.apple.private.Metal.device</key>
    <true/>

    <key>com.apple.private.coreanimation.display-link-privileges</key>
    <true/>

    <!-- ============================================================ -->
    <!-- PREFERENCES                                                  -->
    <!-- ============================================================ -->
    <key>com.apple.private.cfprefs.any-user</key>
    <true/>

    <key>com.apple.private.cfprefs.any-host</key>
    <true/>

</dict>
</plist>
