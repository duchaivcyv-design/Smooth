#!/bin/sh
# Khôi phục cài đặt gốc khi gỡ cài đặt
sysctl -w kern.maxvnodes=30000
sysctl -w kern.maxproc=1024
sysctl -w vm.page_free_target=1024
sysctl -w vm.page_free_min=512
sysctl -w vm.page_speculative_percentage=10
sysctl -w vm.page_free_count=512
sysctl -w kern.memorystatus_purge_on_warning=0
sysctl -w kern.memorystatus_purge_on_urgent=0
sysctl -w kern.memorystatus_purge_on_critical=0
sysctl -w vm.compressor_mode=1
sysctl -w vm.page_background_count=512
sysctl -w vm.page_background_target=1024
sysctl -w vm.pageout_algorithm=0
sysctl -w vm.page_free_reserved=128
sysctl -w kern.sched_preempt_threshold=50
sysctl -w kern.timer_coalescing=1
sysctl -w kern.timer_coalesce=1
sysctl -w kern.timer_coalescing_bg=1
sysctl -w kern.timer_coalescing_fg=1
sysctl -w kern.timer_coalescing_idle=1
sysctl -w kern.timer_coalescing_ktrace=1
sysctl -w kern.timer_coalescing_sys=1
sysctl -w kern.timer_coalescing_user=1
sysctl -w kern.timer_coalescing_window=1
sysctl -w kern.timer_coalescing_window_bg=1
sysctl -w kern.timer_coalescing_window_fg=1
sysctl -w kern.timer_coalescing_window_idle=1
sysctl -w kern.timer_coalescing_window_ktrace=1
sysctl -w kern.timer_coalescing_window_sys=1
sysctl -w kern.timer_coalescing_window_user=1
sysctl -w kern.timer_coalescing_window_window=1
sysctl -w kern.timer_coalescing_window_window_bg=1
sysctl -w kern.timer_coalescing_window_window_fg=1
sysctl -w kern.timer_coalescing_window_window_idle=1
sysctl -w kern.timer_coalescing_window_window_ktrace=1
sysctl -w kern.timer_coalescing_window_window_sys=1
sysctl -w kern.timer_coalescing_window_window_user=1
sysctl -w kern.timer_coalescing_window_window_window=1
sysctl -w kern.timer_coalescing_window_window_window_bg=1
sysctl -w kern.timer_coalescing_window_window_window_fg=1
sysctl -w kern.timer_coalescing_window_window_window_idle=1
sysctl -w kern.timer_coalescing_window_window_window_ktrace=1
sysctl -w kern.timer_coalescing_window_window_window_sys=1
sysctl -w kern.timer_coalescing_window_window_window_user=1
sysctl -w kern.timer_coalescing_window_window_window_window=1

# Khôi phục cache
mkdir -p /var/mobile/Library/Caches
mkdir -p /var/mobile/Library/Logs
mkdir -p /tmp
mkdir -p /var/log
