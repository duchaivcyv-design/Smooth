#!/bin/sh
# ====================================================================================================
# SCRIPT PRERM: DỌN SẠCH TOÀN BỘ CẤU HÌNH & TRẢ VỀ MẶC ĐỊNH APPLE
# (HỖ TRỢ: ROOTLESS, ROOTHIDE, PALERA1N, DOPAMINE, XINA & STANDARD JAILBREAK)
# ====================================================================================================

# 1. XÁC ĐỊNH GỐC JAILBREAK (TỐI ƯU VỚI BIẾN MÔI TRƯỜNG)
JB_ROOT=""
if [ -n "$JBROOT" ] && [ -d "$JBROOT" ]; then
    JB_ROOT="$JBROOT"
elif [ -n "$ROOTLESS_PATH" ] && [ -d "$ROOTLESS_PATH" ]; then
    JB_ROOT="$ROOTLESS_PATH"
elif [ -n "$JB_ROOT_PATH" ] && [ -d "$JB_ROOT_PATH" ]; then
    JB_ROOT="$JB_ROOT_PATH"
elif [ -L "/var/jb" ] || [ -d "/var/jb" ]; then
    JB_ROOT="/var/jb"
else
    ROOTHIDE_DIR=$(find /private/preboot -maxdepth 3 -type d -name "jb-*" 2>/dev/null | head -n 1)
    if [ -z "$ROOTHIDE_DIR" ]; then
        ROOTHIDE_DIR=$(find /var -maxdepth 2 -type d -name "jb-*" 2>/dev/null | head -n 1)
    fi
    if [ -n "$ROOTHIDE_DIR" ] && [ -d "$ROOTHIDE_DIR" ]; then
        JB_ROOT="$ROOTHIDE_DIR"
    fi
fi

# 2. DANH SÁCH CÁC GỐC CẦN DỌN DẸP (BAO GỒM CẢ TRƯỜNG HỢP KHÔNG PHẢI ROOTLESS)
# Nếu JB_ROOT trùng với /var/jb hoặc rỗng, mảng tự động lọc trùng bên dưới.
BASES="$JB_ROOT /var/jb /"

# 3. VÒNG LẶP DỌN DẸP (XỬ LÝ ĐA MÔI TRƯỜNG, CHỐNG TRÙNG LẶP)
for BASE in $BASES; do
    [ -z "$BASE" ] && continue
    
    # Dọn PreferenceLoader & Substrate
    rm -f "$BASE/Library/PreferenceLoader/Preferences/BoostiPhone6sPrefs.plist" 2>/dev/null || true
    rm -f "$BASE/Library/PreferenceLoader/Preferences/BoostiPhone6s.plist" 2>/dev/null || true
    rm -f "$BASE/Library/PreferenceLoader/BoostiPhone6sPrefs.plist" 2>/dev/null || true
    rm -f "$BASE/Library/PreferenceLoader/BoostiPhone6s.plist" 2>/dev/null || true
    rm -f "$BASE/Library/MobileSubstrate/DynamicLibraries/BoostiPhone6sCore.plist" 2>/dev/null || true
    rm -f "$BASE/Library/MobileSubstrate/DynamicLibraries/BoostiPhone6s.plist" 2>/dev/null || true

    # Dọn Cấu hình & Cache của App
    rm -f "$BASE/var/mobile/Library/Preferences/com.taojb.boostiphone6s.plist" 2>/dev/null || true
    rm -f "$BASE/Library/Preferences/com.taojb.boostiphone6s.plist" 2>/dev/null || true
    rm -rf "$BASE/var/mobile/Library/Caches/com.taojb.boostiphone6s" 2>/dev/null || true

    # Dọn file IPC / Tmp / Boot Guard
    rm -f "$BASE"/tmp/.boost_hz_sync* 2>/dev/null || true
    rm -f "$BASE"/tmp/.boost_hz_apps* 2>/dev/null || true
    rm -f "$BASE/tmp/.boost_boot_counter" 2>/dev/null || true
    rm -f "$BASE/tmp/.titanium_tweak_verified" 2>/dev/null || true
done

# 4. DỌN CÁC FILE TMP TOÀN CỤC (NẰM NGOÀI ROOT)
rm -f /tmp/.boost_hz_sync* 2>/dev/null || true
rm -f /tmp/.boost_hz_apps* 2>/dev/null || true
rm -f /tmp/.boost_boot_counter 2>/dev/null || true
rm -f /tmp/.titanium_tweak_verified 2>/dev/null || true
rm -f /tmp/.titanium_boot_guard 2>/dev/null || true
rm -f /tmp/.titanium_8p_reboot_staged 2>/dev/null || true
rm -f /tmp/.titanium_sync_payload 2>/dev/null || true

# 5. XÓA BẰNG DEFAULTS (CHỐNG SÓT CẤU HÌNH)
defaults delete com.taojb.boostiphone6s 2>/dev/null || true

# 6. PHÁT TÍN HIỆU NOTIFY (NẾU CÓ)
if command -v notifyutil >/dev/null 2>&1; then
    for NOTIF in ReloadPrefs ReloadUIKitPrefs HardwareSync FPSChanged; do
        notifyutil -p "com.taojb.boostiphone6s/$NOTIF" >/dev/null 2>&1 || true
    done
    notifyutil -p com.titanium.v285.prefschanged >/dev/null 2>&1 || true
fi

# 7. DIỆT CFPREFSD ĐỂ ĐỒNG BỘ BỘ NHỚ ĐỆM
killall -9 cfprefsd 2>/dev/null || true

exit 0
