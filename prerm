#!/bin/bash

# prerm - Pre-removal script for Boost iPhone 6s-X v7.0
# Target: Rootless Jailbreak (iOS 14.0 - 26.0.1)

set +e # Tiếp tục thực thi dù có lỗi nhỏ

echo ""
echo "=================================================="
echo "   BOOST iPHONE 6s-X ULTIMATE EDITION v7.0"
echo "   Status: UNINSTALLING..."
echo "=================================================="

# 1. XÓA ENTRY PLIST ĐĂNG KÝ MENU SETTINGS
# ★ QUAN TRỌNG: Ngăn chặn menu "ma" xuất hiện sau khi gỡ tweak
ENTRY_PLIST="/var/jb/Library/PreferenceLoader/Entries/BoostiPhone6sPrefs.plist"
if [ -f "$ENTRY_PLIST" ]; then
    rm -f "$ENTRY_PLIST"
    echo "[OK] PreferenceLoader entry removed."
else
    echo "[INFO] No PreferenceLoader entry found."
fi

# 2. XÓA CACHE RIÊNG CỦA TWEAK
TWEAK_CACHE="/var/mobile/Library/Caches/com.boostiphone6s.settings"
if [ -d "$TWEAK_CACHE" ]; then
    rm -rf "$TWEAK_CACHE"
    echo "[OK] Tweak-specific cache cleared."
else
    echo "[INFO] No tweak cache found to clean."
fi

# 3. RESET CFPREFSD AN TOÀN CHO ROOTLESS
# Không unload/load daemon trực tiếp. Chỉ cần xóa file là đủ.
# SpringBoard sẽ tự động reload preference cache sau khi respring.
echo "[INFO] Preferences cache will be refreshed after respring."

# 4. XÓA USERDEFAULTS KEY SAFE MODE (NẾU CÓ)
# Đảm bảo lần cài đặt sau không bị kẹt trong Safe Mode cũ
if command -v defaults &> /dev/null; then
    defaults delete com.boostiphone6s.settings BoostiPhone6s_SafeModeActive 2>/dev/null || true
    defaults delete com.boostiphone6s.settings BoostiPhone6s_LastCrashReason 2>/dev/null || true
    echo "[OK] Safe Mode state reset."
fi

echo ""
echo "=================================================="
echo "   UNINSTALLATION COMPLETE!"
echo "   Please RESPRING your device to finalize changes."
echo "=================================================="
echo ""

exit 0
