<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Xác thực Platform Binary với Kernel & AMFI -->
    <key>platform-application</key>
    <true/>

    <!-- Cho phép nạp dylib ngoài và bỏ qua kiểm tra chữ ký thư viện (iOS 15+) -->
    <key>com.apple.private.skip-library-validation</key>
    <true/>

    <!-- Toàn quyền đọc ghi tệp hệ thống ngoài sandbox thông qua TCC -->
    <key>com.apple.private.tcc.allow</key>
    <array>
        <string>kTCCServiceSystemPolicyAllFiles</string>
    </array>

    <!-- Quyền truy cập thư mục dữ liệu App dùng chung -->
    <key>com.apple.private.security.storage.AppDataContainers</key>
    <true/>

    <!-- Kết nối mạng không giới hạn -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Cho phép mở Task Port đọc thông số tiến trình & phần cứng -->
    <key>get-task-allow</key>
    <true/>
    <key>task_for_pid-allow</key>
    <true/>
    <key>com.apple.system-task-ports</key>
    <true/>

    <!-- Truy cập IOKit cảm biến phần cứng (SoC, Pin, Màn hình) -->
    <key>com.apple.security.iokit-user-client-class</key>
    <array>
        <string>IOPMrootDomain</string>
        <string>AppleARMIODevice</string>
        <string>AppleSmartBattery</string>
        <string>AppleSmartBatteryCommands</string>
        <string>IOPlatformPluginDevice</string>
    </array>
</dict>
</plist>
