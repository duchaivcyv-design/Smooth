<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- [BẮT BUỘC]: Đưa tiến trình lên mức Platform Binary (Vượt AMFI trên cả Rootless & RootHide) -->
    <key>platform-application</key>
    <true/>

    <!-- [BẮT BUỘC]: Phá bỏ Container Sandbox (Cho phép đọc/ghi tự do /tmp và /var/jb) -->
    <key>com.apple.private.security.no-container</key>
    <true/>

    <!-- Quyền truy cập toàn bộ hệ thống tệp và cấu hình hệ thống (Bypass TCC) -->
    <key>com.apple.private.tcc.allow</key>
    <array>
        <string>kTCCServiceSystemPolicyAllFiles</string>
    </array>

    <!-- Quyền truy cập thư mục dữ liệu ứng dụng dùng chung -->
    <key>com.apple.private.security.storage.AppDataContainers</key>
    <true/>

    <!-- Giao tiếp điều phối và khởi chạy ứng dụng với SpringBoard -->
    <key>com.apple.springboard.launchapplications</key>
    <true/>
    <key>com.apple.frontboard.launchapplications</key>
    <true/>

    <!-- Kết nối Mach Service hệ thống không bị chặn bởi Sandbox -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Truy cập IOKit để đọc cảm biến phần cứng (SoC, Pin, Màn hình thực tế) -->
    <key>com.apple.security.iokit-user-client-class</key>
    <array>
        <string>IOPMrootDomain</string>
        <string>AppleARMIODevice</string>
        <string>AppleSmartBattery</string>
        <string>AppleSmartBatteryCommands</string>
        <string>IOPlatformPluginDevice</string>
    </array>

    <!-- Quyền Task port phục vụ phân tích tiến trình và spawn lệnh hệ thống -->
    <key>get-task-allow</key>
    <true/>
    <key>task_for_pid-allow</key>
    <true/>
</dict>
</plist>
